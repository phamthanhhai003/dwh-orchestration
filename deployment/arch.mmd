%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "primaryColor": "#dbeafe", "primaryTextColor": "#1e3a5f", "primaryBorderColor": "#2563eb", "lineColor": "#64748b", "secondaryColor": "#f0fdf4", "tertiaryColor": "#fefce8"}}}%%
graph TD
    subgraph SRC["  SOURCE  "]
        MSSQL(["SQL Server 2022<br/>39 T24 tables"])
    end

    subgraph CDC["  CDC / STREAMING  "]
        KAFKA(["Kafka KRaft<br/>Strimzi 0.45.0"])
        DEBEZIUM(["Debezium<br/>Kafka Connect"])
        KAFKAUI(["Kafka UI"])
    end

    subgraph ORCH["  ORCHESTRATION  "]
        AIRFLOW(["Airflow 3.x<br/>KubernetesExecutor"])
        JENKINS(["Jenkins<br/>CI/CD"])
    end

    subgraph PROC["  PROCESSING  "]
        SPARK(["Spark 3.5.1<br/>Kubernetes Operator"])
        DBT(["dbt<br/>Dremio adapter"])
    end

    subgraph STORE["  STORAGE  "]
        MINIO(["MinIO<br/>S3-compatible"])
        HIVE(["Hive Metastore<br/>Iceberg catalog"])
        PG(["PostgreSQL<br/>ETL state"])
        REDIS(["Redis<br/>Celery broker"])
        DREMIO(["Dremio<br/>Query engine"])
    end

    subgraph OBS["  OBSERVABILITY  "]
        ELK(["ELK Stack<br/>ES · Kibana · Logstash"])
    end

    subgraph RPT["  REPORTING  "]
        PBIRS(["Power BI PBIRS<br/>5 domains"])
    end

    MSSQL -->|"Debezium CDC"| KAFKA
    KAFKA --> DEBEZIUM
    DEBEZIUM --> MINIO

    AIRFLOW -->|"SparkApplication CRD"| SPARK
    SPARK -->|"parse / sync"| MINIO
    MINIO --> HIVE
    HIVE --> DREMIO
    DREMIO --> DBT
    DBT --> PBIRS

    AIRFLOW --> PG
    AIRFLOW --> REDIS
    JENKINS -->|"trigger DAG"| AIRFLOW
    SPARK -->|"logs"| ELK

    classDef src  fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    classDef cdc  fill:#fff7ed,stroke:#ea580c,color:#7c2d12
    classDef orch fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef proc fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef stor fill:#f5f3ff,stroke:#7c3aed,color:#3b0764
    classDef obs  fill:#fefce8,stroke:#ca8a04,color:#713f12
    classDef rpt  fill:#ecfeff,stroke:#0891b2,color:#164e63

    class MSSQL src
    class KAFKA,DEBEZIUM,KAFKAUI cdc
    class AIRFLOW,JENKINS orch
    class SPARK,DBT proc
    class MINIO,HIVE,PG,REDIS,DREMIO stor
    class ELK obs
    class PBIRS rpt
