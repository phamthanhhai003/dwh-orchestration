# Bake t24 parser + entrypoints + jars vào image Spark.
# Bỏ hẳn MinIO presigned-deps + render script. Build context = REPO ROOT:
#   docker build -f spark/Dockerfile.t24 -t <registry>/spark-t24:v1 .
FROM haiptjits/spark-3.5.1:v2

USER root

# 1) jars (kafka + mssql) -> classpath Spark có sẵn
COPY spark/jars/*.jar /opt/spark/jars/

# 2) parser lib -> pip install. Base image Python 3.8 < pyproject '>=3.9', nhưng
#    code 3.8-compatible (from __future__ import annotations) — đã chạy cả buổi qua
#    zip pyFiles → bỏ qua check bằng --ignore-requires-python.
COPY libs/t24_parser /tmp/t24_parser
RUN pip install --no-cache-dir --ignore-requires-python /tmp/t24_parser \
    && rm -rf /tmp/t24_parser

# 3) pyarrow cho bcp streaming extract (boto3 đã có từ base)
RUN pip install --no-cache-dir pyarrow==17.0.0

# 5) mssql-tools (bcp) cho bulk extract
RUN curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | apt-key add - \
    && curl -fsSL https://packages.microsoft.com/config/ubuntu/20.04/prod.list \
       > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends mssql-tools unixodbc-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV PATH="$PATH:/opt/mssql-tools/bin"

# 6) entrypoints (streaming CDC + batch/pull + bcp extract) -> local:///opt/jobs/*.py
COPY jobs/ /opt/jobs/

# 7) SFTP HOLD scripts (fetch + parse) -> local:///opt/jobs/*.py
#    Trước đây đẩy lên s3a://spark-scripts/ thủ công; bake vào image cho đồng bộ với
#    CDC/pull, hết drift upload tay.
#    - scripts/parser/*.py: parser standalone PySpark (không import t24_parser lib).
#    - scripts/sync/*.py:   fetch SFTP->MinIO (sftp_sync_spark.py dùng paramiko, có sẵn base).
COPY scripts/parser/*.py /opt/jobs/
COPY scripts/sync/*.py /opt/jobs/
